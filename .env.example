SECRET_KEY=change-me-to-a-long-random-value
# Optional: set a known password for the default admin account instead of
# letting the app generate a random one at first run.
# ADMIN_PASSWORD=

# Set to 1 only for local HTTP-only development (no HTTPS). Leave unset in
# production so session cookies require HTTPS.
# FORCE_INSECURE_COOKIES=1

# Set to 1 only for local development. Never enable in production.
# FLASK_DEBUG=1
